{
  "$schema": "https://starwind.dev/config-schema.v2.json",
  "version": 2,
  "framework": "astro",
  "registry": {
    "source": "bundled",
    "version": "2.1.0"
  },
  "pro": {
    "registry": {
      "url": "https://pro.starwind.dev/r/{name}",
      "headers": {
        "Authorization": "Bearer ${STARWIND_LICENSE_KEY}"
      }
    }
  },
  "components": [
    {
      "name": "button",
      "version": "3.0.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "avatar",
      "version": "2.0.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "badge",
      "version": "1.5.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "card",
      "version": "2.3.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "accordion",
      "version": "2.0.3",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "aspect-ratio",
      "version": "1.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "image",
      "version": "1.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "input",
      "version": "2.0.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "label",
      "version": "1.3.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "textarea",
      "version": "1.4.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "video",
      "version": "1.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "tabs",
      "version": "2.0.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "switch",
      "version": "2.0.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "tooltip",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    }
  ],
  "tailwind": {
    "css": "src/styles/starwind.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "componentDir": "src/components/starwind",
  "utilsDir": "src/lib/utils"
}
