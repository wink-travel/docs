---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro";
import Footer3 from "@/components/starwind-pro/footer-03/Footer3Demo.astro";
import MarketingFooter from "@/components/marketing/MarketingFooter.astro";

const entry = Astro.locals.starlightRoute.entry;
const isSplash = entry?.data.template === "splash";
const useMarketingNav = entry?.data.marketingNav === true;
---

{
  useMarketingNav ? <MarketingFooter /> : isSplash ? <Footer3 /> : <DefaultFooter />
}
