---
import IconExtranet from "@/assets/product-icons/product-extranet.svg";
import IconStudio from "@/assets/product-icons/product-studio.svg";
import IconSocial from "@/assets/product-icons/product-social.svg";
import IconWinkLinks from "@/assets/product-icons/product-winklinks.svg";
import IconBookingEngine from "@/assets/product-icons/product-booking-engine.svg";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import traveliko from "@/assets/product-icons/product-traveliko.png";
import apiIcon from "@/assets/product-icons/product-api.png";

const products = [
  { name: "Extranet", desc: "Control hotel supply, rates, content, offers, policies, and Booking Engine config.", href: "/products/extranet/", icon: IconExtranet },
  { name: "Studio", desc: "Turn supply into links, cards, maps, grids, Web Components, and QR-ready assets.", href: "/products/studio/", icon: IconStudio },
  { name: "Social", desc: "Plan, generate, approve, schedule, publish, and measure content with booking routes.", href: "/products/social/", icon: IconSocial },
  { name: "WinkLinks", desc: "Publish mobile-first storefronts for hotels, partners, campaigns, and QR traffic.", href: "/products/winklinks/", icon: IconWinkLinks },
  { name: "Traveliko", desc: "The Wink-operated consumer discovery channel for participating hotels.", href: "/products/traveliko/", img: traveliko.src, logoOnly: true },
  { name: "Developers", desc: "Build hotel search, booking, payment, webhook, and attribution into your product.", href: "/builders/", img: apiIcon.src },
];
---

<section class="@container mx-auto w-full max-w-7xl px-4 pt-24">
  <div class="mx-auto mb-12 max-w-3xl text-center">
    <p class="mkt-kicker text-primary">Platform</p>
    <h2 class="mkt-h2 font-heading mt-3">
      Discover the building blocks of modern travel commerce.
    </h2>
    <p class="mkt-sub text-muted-foreground mt-4">
      Powering every stage of the journey—from hotel inventory management and distribution to bookings, payments, and APIs.
    </p>
  </div>

  {/* Booking Engine — emphasized fulfillment band */}
  <a
    href="/products/booking-engine/"
    class="group mb-6 flex flex-col gap-4 rounded-2xl border-2 border-primary/30 bg-primary/[0.06] p-6 transition-colors hover:border-primary/50 @lg:flex-row @lg:items-center"
  >
    <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primary">
      <IconBookingEngine class="size-9" />
    </span>
    <div class="grow">
      <div class="flex items-center gap-2">
        <h3 class="font-heading text-xl font-semibold">Booking Engine</h3>
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Fulfillment layer</span>
      </div>
      <p class="text-muted-foreground mt-1 text-pretty">
        Fulfill bookings across websites, Shareable Links, QR codes, Web Components, WinkLinks, partner
        routes, Traveliko, Agentic AI, and developer-powered flows.
      </p>
    </div>
    <span class="text-primary inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold">
      Explore <IconArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </a>

  <div class="grid gap-4 @md:grid-cols-2 @3xl:grid-cols-3">
    {
      products.map((p) => {
        const Icon = p.icon as any;
        return (
        <a
          href={p.href}
          class="group flex flex-col rounded-2xl border border-border bg-card p-6 transition-colors hover:border-primary/40"
        >
          {p.logoOnly ? (
            <span class="mb-4 flex h-12 items-center">
              <img src={p.img} alt={p.name} class="h-9 w-auto object-contain" />
            </span>
          ) : (
            <span class="mb-4 flex size-12 items-center justify-center rounded-xl bg-muted">
              {p.img ? (
                <img src={p.img} alt="" class="size-7 object-contain" />
              ) : (
                <Icon class="size-7 text-primary" />
              )}
            </span>
          )}
          <h3 class="font-heading text-lg font-semibold">{p.name}</h3>
          <p class="text-muted-foreground mt-2 grow text-sm text-pretty">{p.desc}</p>
          <span class="text-primary mt-4 inline-flex items-center gap-1.5 text-sm font-medium">
            Explore {p.name}
            <IconArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
        );
      })
    }
  </div>
</section>
