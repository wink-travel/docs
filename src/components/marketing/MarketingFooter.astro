---
import IconBrandLinkedin from "@tabler/icons/outline/brand-linkedin.svg";
import IconBrandX from "@tabler/icons/outline/brand-x.svg";
import IconBrandInstagram from "@tabler/icons/outline/brand-instagram.svg";
import IconBrandFacebook from "@tabler/icons/outline/brand-facebook.svg";
import IconBrandYoutube from "@tabler/icons/outline/brand-youtube.svg";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import WinkFace from "@/assets/wink-face.svg";

const APP_URL = "https://app.wink.travel";

type Link = { label: string; href: string };

const columns: { title: string; links: Link[] }[] = [
  {
    title: "Solutions",
    links: [
      { label: "For Hotels", href: "/hotels/" },
      { label: "For Partners", href: "/partners/" },
      { label: "For Travel Creators", href: "/travel-content-creators/" },
      { label: "For Developers", href: "/dev/" },
      { label: "All solutions", href: "/solutions/" },
    ],
  },
  {
    title: "Products",
    links: [
      { label: "Booking Engine", href: "/products/booking-engine/" },
      { label: "Extranet", href: "/products/extranet/" },
      { label: "Studio", href: "/products/studio/" },
      { label: "Social", href: "/products/social/" },
      { label: "WinkLinks", href: "/products/winklinks/" },
      { label: "Traveliko", href: "/products/traveliko/" },
      { label: "Agentic AI", href: "/agentic-ai/" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Resources hub", href: "/resources/" },
      { label: "State of Direct Distribution", href: "/resources/state-of-direct-distribution/" },
      { label: "Academy", href: "/getting-started/key-features/" },
      { label: "Blog", href: "/blog/" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Build on Wink", href: "/developers/build-on-wink/" },
      { label: "MCP server", href: "/developers/mcp/" },
      { label: "AI Skills", href: "/developers/ai-skills/" },
      { label: "API reference", href: "/api/" },
      { label: "llms.txt", href: "/llms.txt" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about/" },
      { label: "Pricing", href: "/pricing/" },
      { label: "Log in", href: APP_URL },
      { label: "Sign up", href: APP_URL },
      { label: "Press", href: "mailto:press@wink.travel" },
    ],
  },
];

const socials = [
  { name: "LinkedIn", icon: IconBrandLinkedin, href: "https://www.linkedin.com/company/wink-travel" },
  { name: "X", icon: IconBrandX, href: "https://x.com/winktravel" },
  { name: "Instagram", icon: IconBrandInstagram, href: "https://www.instagram.com/wink.travel" },
  { name: "Facebook", icon: IconBrandFacebook, href: "https://www.facebook.com/wink.travel" },
  { name: "YouTube", icon: IconBrandYoutube, href: "https://www.youtube.com/@winktravel" },
];

// Site-wide structured data (rendered on every marketing page via the footer)
// so search and answer engines understand the Wink entity and its profiles.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://wink.travel/#organization",
      name: "Wink",
      legalName: "Wink Travel",
      url: "https://wink.travel/",
      logo: "https://wink.travel/favicon.svg",
      description:
        "Travel commerce infrastructure for hotels, partners, creators, developers and AI agents. Hotels control supply and sell direct across social, partner, consumer, AI and platform routes — Booking Engine fulfills every route at 5.5% all-in.",
      sameAs: [
        "https://www.linkedin.com/company/wink-travel",
        "https://x.com/winktravel",
        "https://www.instagram.com/wink.travel",
        "https://www.facebook.com/wink.travel",
        "https://www.youtube.com/@winktravel",
        "https://github.com/wink-travel",
      ],
      founder: [
        { "@type": "Person", name: "Ben Taylor", jobTitle: "Co-founder & CEO", sameAs: "https://linkedin.com/in/bentaylor" },
        { "@type": "Person", name: "Yann Gouriou", jobTitle: "Co-founder & COO", sameAs: "https://linkedin.com/in/yanng17" },
        { "@type": "Person", name: "Bjorn Harvold", jobTitle: "Co-founder & CTO", sameAs: "https://linkedin.com/in/bjornharvold" },
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Bangkok",
        addressCountry: "TH",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "press",
        email: "press@wink.travel",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://wink.travel/#website",
      url: "https://wink.travel/",
      name: "Wink",
      description: "Travel commerce infrastructure for hotels, partners, creators, developers and AI agents.",
      publisher: { "@id": "https://wink.travel/#organization" },
      inLanguage: "en",
    },
  ],
};
---

<footer class="not-content w-full overflow-hidden rounded-2xl bg-[#8039d8] text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-11 lg:px-6">
    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Brand block -->
      <div class="lg:col-span-3">
        <a href="/" class="inline-flex" aria-label="Wink home">
          <WinkFace class="size-14 shrink-0 rounded-full" />
        </a>
        <p class="mt-3 max-w-xs text-pretty text-sm text-white/70">
          Travel commerce infrastructure for hotels, partners, creators, developers and AI agents.
        </p>
        <a
          href="/agentic-ai/"
          class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-semibold text-white/90 transition-colors hover:bg-white/15"
        >
          Built for AI agents
          <IconArrowRight class="size-3.5" />
        </a>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Wink on ${s.name}`}
              class="inline-flex size-8 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
            >
              <s.icon class="size-4" />
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-7 sm:grid-cols-3 lg:col-span-9 lg:grid-cols-5">
        {columns.map((col) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-white/55">{col.title}</h2>
            <ul class="mt-3.5 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a class="text-sm text-white/80 transition-colors hover:text-white" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/15 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-white/70">© 2026 Wink. All rights reserved.</p>
      <nav aria-label="Legal" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href="/terms/" class="text-white/70 transition-colors hover:text-white">Terms</a>
        <a href="/privacy/" class="text-white/70 transition-colors hover:text-white">Privacy</a>
        <a href="/cookies/" class="text-white/70 transition-colors hover:text-white">Cookies</a>
        <a href="/acceptable-use/" class="text-white/70 transition-colors hover:text-white">Acceptable use</a>
      </nav>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</footer>
