---
import IconBrandLinkedin from "@tabler/icons/outline/brand-linkedin.svg";
import IconBrandX from "@tabler/icons/outline/brand-x.svg";
import IconBrandInstagram from "@tabler/icons/outline/brand-instagram.svg";
import IconBrandTiktok from "@tabler/icons/outline/brand-tiktok.svg";
import IconBrandYoutube from "@tabler/icons/outline/brand-youtube.svg";

const APP_URL = "https://app.wink.travel";

type Link = { label: string; href?: string; note?: string };

const columns: { title: string; links: Link[] }[] = [
  {
    title: "Solutions",
    links: [
      { label: "For Hotels", href: "/hotels/" },
      { label: "For Partners", href: "/partners/" },
      { label: "For Developers", href: "/dev/" },
      { label: "All solutions", href: "/solutions/" },
    ],
  },
  {
    title: "Products",
    links: [
      { label: "Booking Engine", href: "/products/booking-engine/" },
      { label: "Extranet", href: "/products/extranet/" },
      { label: "Studio", href: "/products/studio/" },
      { label: "Social", href: "/products/social/" },
      { label: "WinkLinks", href: "/products/winklinks/" },
      { label: "Traveliko", href: "/products/traveliko/" },
      { label: "Agentic AI", href: "/agentic-ai/" },
      { label: "All products", href: "/products/" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Resources hub", href: "/resources/" },
      { label: "State of Direct Distribution", href: "/resources/state-of-direct-distribution/" },
      { label: "Academy", href: "/getting-started/" },
      { label: "Blog", href: "/blog/" },
      { label: "Build on Wink", href: "/developers/build-on-wink/" },
      { label: "llms.txt", href: "/llms.txt" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about/" },
      { label: "Pricing", href: "/pricing/" },
      { label: "Login", href: APP_URL },
      { label: "Sign up", href: APP_URL },
      { label: "Press contact", href: "mailto:press@wink.travel" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Terms", href: "/terms/" },
      { label: "Privacy", href: "/privacy/" },
      { label: "Cookies", note: "forthcoming" },
      { label: "Acceptable use", note: "forthcoming" },
    ],
  },
];

const socials = [
  { name: "LinkedIn", icon: IconBrandLinkedin, href: "https://www.linkedin.com/company/wink-travel" },
  { name: "X", icon: IconBrandX, href: "https://x.com/winktravel" },
  { name: "Instagram", icon: IconBrandInstagram, href: "https://www.instagram.com/wink.travel" },
  { name: "TikTok", icon: IconBrandTiktok, href: "https://www.tiktok.com/@wink.travel" },
  { name: "YouTube", icon: IconBrandYoutube, href: "https://www.youtube.com/@winktravel" },
];
---

<footer class="not-content w-full bg-[#8039d8] text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 lg:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
      <!-- Brand block -->
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <a href="/" class="text-2xl font-bold tracking-tight text-white">wink</a>
        <p class="mt-3 max-w-xs text-sm text-white/70">
          Travel commerce infrastructure for AI agents.
        </p>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              class="inline-flex size-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
            >
              <s.icon class="size-5" />
            </a>
          ))}
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white/60">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                {link.href ? (
                  <a class="text-sm text-white/80 transition-colors hover:text-white" href={link.href}>
                    {link.label}
                  </a>
                ) : (
                  <span class="text-sm text-white/50">
                    {link.label}
                    {link.note && <span class="ml-1 text-xs">({link.note})</span>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/15 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-white/70">© 2026 Wink. All rights reserved.</p>
      <p class="text-sm text-white/70">Travel commerce infrastructure for AI agents.</p>
    </div>
  </div>
</footer>
