---
/**
 * Tab-styled switcher across the three documents that govern how money moves.
 *
 * These are deliberately NOT merged into one tabbed page. Each is a separate
 * contract with a different counterparty and a different answer to the same
 * question — who collects, and who is the merchant of record:
 *
 *   Accommodation Provider Payment Terms  hotel ↔ TripPay; Section 1 IS the
 *                                          appointment of TripPay as agent
 *   Demand Partner Payment Terms          partner ↔ TripPay; the mirror — the
 *                                          partner does NOT appoint TripPay
 *   Agent-Collected Channel Addendum      hotel ↔ Wink; the travel agent
 *                                          collects and neither is in the flow
 *
 * One URL hosting all three would make "the Payment Terms you accepted"
 * ambiguous at exactly the point the agency structure depends on, collide the
 * per-clause anchors (all three number sections from 1), and collapse three
 * indexable documents into one. So each keeps its own page, and this gives the
 * tab affordance across them.
 *
 * Pass `current` as the slug of the page rendering it.
 */
interface Props {
  current: "accommodation-provider-payment-terms" | "demand-partner-payment-terms" | "agent-collected-channel-addendum";
}
const { current } = Astro.props as Props;

const tabs = [
  {
    slug: "accommodation-provider-payment-terms",
    label: "Accommodation Provider",
    note: "TripPay collects for the hotel",
  },
  {
    slug: "demand-partner-payment-terms",
    label: "Demand Partner",
    note: "Commission settlement",
  },
  {
    slug: "agent-collected-channel-addendum",
    label: "Agent-Collected Channel",
    note: "The travel agent collects",
  },
];
---

<nav aria-label="Payment terms by route" class="mx-auto w-full max-w-3xl px-4 pt-8">
  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
    Payment terms by route
  </p>
  <ul class="mt-3 grid gap-2 sm:grid-cols-3">
    {
      tabs.map((t) => {
        const isCurrent = t.slug === current;
        return (
          <li>
            <a
              href={`/legal/${t.slug}/`}
              aria-current={isCurrent ? "page" : undefined}
              class={`flex h-full flex-col rounded-xl border px-4 py-3 transition-colors ${
                isCurrent
                  ? "border-primary bg-primary/[0.06] text-foreground"
                  : "border-border text-muted-foreground hover:border-primary/40 hover:bg-primary/[0.03] hover:text-foreground"
              }`}
            >
              <span class="text-sm font-semibold">{t.label}</span>
              <span class="mt-0.5 text-xs text-muted-foreground">{t.note}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
