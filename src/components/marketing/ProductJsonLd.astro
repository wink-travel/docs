---
/**
 * Structured data for a Wink product page.
 * Emits a schema.org @graph (Organization + SoftwareApplication + FAQPage) so
 * search and answer engines can classify the product, its features and its
 * FAQs. Reusable across product pages — pass name, description, url, features
 * and the same FAQ array the page renders so the two never drift.
 */
interface Faq { title: string; content: string }
const {
  name,
  description,
  url,
  applicationCategory = "BusinessApplication",
  features = [] as string[],
  offersFree = false,
  offers = [] as { name: string; price: string }[],
  faqs = [] as Faq[],
} = Astro.props;

const offerNodes = offers.length
  ? {
      offers: offers.map((o: { name: string; price: string }) => ({
        "@type": "Offer",
        name: o.name,
        price: String(o.price).replace(/[^0-9.]/g, ""),
        priceCurrency: "USD",
      })),
    }
  : offersFree
    ? { offers: { "@type": "Offer", price: "0", priceCurrency: "USD", description: "Free tier available" } }
    : {};

const app: Record<string, unknown> = {
  "@type": "SoftwareApplication",
  "@id": `${url}#software`,
  name,
  applicationCategory,
  operatingSystem: "Web",
  url,
  description,
  provider: { "@id": "https://wink.travel/#organization" },
  ...(features.length ? { featureList: features } : {}),
  ...offerNodes,
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://wink.travel/#organization",
      name: "Wink",
      url: "https://wink.travel/",
      description:
        "Travel commerce infrastructure for hotels, partners, creators, developers and AI agents. Hotels control supply and sell direct; Booking Engine fulfills every route.",
      sameAs: ["https://github.com/wink-travel", "https://www.linkedin.com/company/wink-travel"],
    },
    app,
    ...(faqs.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${url}#faq`,
            mainEntity: faqs.map((f: Faq) => ({
              "@type": "Question",
              name: f.title,
              acceptedAnswer: { "@type": "Answer", text: f.content },
            })),
          },
        ]
      : []),
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
