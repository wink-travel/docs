---
type LogoItem = { src: string; scale?: number; opacity?: number };
interface Props {
  kicker?: string;
  logos?: (string | LogoItem)[];
  count?: number;
}

const { kicker, logos = [], count = 10 } = Astro.props;
const usePlaceholders = logos.length === 0;

/** Derive a readable brand name from a logo filename for the img alt. */
const labelFromSrc = (src: string) =>
  (src.split("/").pop() ?? "")
    .replace(/\.[a-z0-9]+$/i, "")
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .trim();
const items: (string | number | LogoItem)[] = usePlaceholders
  ? Array.from({ length: count }, (_, i) => i)
  : logos;
---

<section class="@container mx-auto w-full max-w-7xl px-4 pt-24">
  {kicker && (
    <p class="mkt-kicker mb-10 text-center text-primary">{kicker}</p>
  )}
  <div class="logo-marquee relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
    <div class="logo-track flex w-max items-center gap-10">
      {[0, 1].map((dup) => (
        <ul class="flex shrink-0 items-center gap-10" aria-hidden={dup === 1 ? "true" : undefined}>
          {items.map((it) =>
            usePlaceholders ? (
              <li class="flex h-14 w-36 shrink-0 items-center justify-center rounded-xl border border-border bg-muted/40">
                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/50">Logo</span>
              </li>
            ) : (
              <li class="logo-card flex h-24 w-44 shrink-0 items-center justify-center rounded-xl border border-border bg-white p-5 shadow-sm">
                {(() => {
                  const L: LogoItem = typeof it === "string" ? { src: it } : (it as LogoItem);
                  // Per-logo tuning goes out as custom properties rather than
                  // literal `opacity:`/`transform:` declarations: an inline style
                  // beats any stylesheet rule, so the hover state below could
                  // never restore full opacity while opacity was written inline.
                  return (
                    <img
                      src={L.src}
                      alt={labelFromSrc(L.src)}
                      class="max-h-full max-w-full object-contain"
                      style={`--logo-opacity:${L.opacity ?? 0.75}${L.scale ? `;--logo-scale:${L.scale}` : ""}`}
                      loading="lazy"
                      decoding="async"
                    />
                  );
                })()}
              </li>
            )
          )}
        </ul>
      ))}
    </div>
  </div>
  {usePlaceholders && (
    <p class="text-muted-foreground mt-4 text-center text-xs">Hotel & partner logos — placeholders for now.</p>
  )}
</section>

<style>
  .logo-track {
    /* Force full content width — the `w-max` utility isn't generated in this
       Tailwind build, so without this the track collapses to the container
       width and translateX(-50%) leaves a gap instead of a seamless loop. */
    width: max-content;
    animation: logo-scroll 40s linear infinite;
  }
  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }

  /* Brand colour on hover — ported from the portal home page's logo wall
     (monorepo-typescript: libs/portals/feature-home/.../portal-feature-home.component.css).
     Logos rest desaturated and dimmed so the wall reads as one texture, then
     resolve to full colour under the cursor. The portal dims with
     `brightness(0.6)`; here the cards are always `bg-white`, so opacity does
     that job without needing the portal's dark-theme brightness variants.
     Pairs with the pause rule above: the marquee stops so a logo can actually
     be hovered rather than sliding out from under the pointer. */
  .logo-card img {
    filter: grayscale(100%);
    opacity: var(--logo-opacity, 0.75);
    transform: scale(var(--logo-scale, 1));
    transition:
      filter 0.4s ease,
      opacity 0.4s ease;
  }
  .logo-card:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-card img {
      transition: none;
    }
  }
  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 1.25rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }
</style>
