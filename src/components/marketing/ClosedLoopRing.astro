---
import IconBrush from "@tabler/icons/outline/brush.svg";
import IconShare from "@tabler/icons/outline/share.svg";
import IconArrowsRight from "@tabler/icons/outline/arrows-right.svg";
import IconCircleCheck from "@tabler/icons/outline/circle-check.svg";
import IconChartHistogram from "@tabler/icons/outline/chart-histogram.svg";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";

const steps = [
  { n: 1, title: "Create", icon: IconBrush, desc: "Approved supply, offers, rooms, and content." },
  { n: 2, title: "Distribute", icon: IconShare, desc: "Links, social, storefronts, Traveliko, AI handoffs." },
  { n: 3, title: "Convert", icon: IconArrowsRight, desc: "Attention turns into a hotel-specific booking." },
  { n: 4, title: "Fulfill", icon: IconCircleCheck, desc: "Booking Engine takes payment and confirms." },
  { n: 5, title: "Learn", icon: IconChartHistogram, desc: "Every booking stays attributed to its route." },
];
---

<section class="@container w-full overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-[#2a0f52] via-[#1f0a40] to-[#150629] text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-20">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="mkt-kicker text-[#ff8a5c]">The closed loop</p>
      <h2 class="mkt-h2 font-heading mt-3">
        Create. Distribute. Convert. Fulfill. Learn.
      </h2>
      <p class="mkt-sub mx-auto mt-4 max-w-xl text-white/60">
        Every step feeds the next — a continuous commerce loop from hotel supply to confirmed booking and back.
      </p>
    </div>

    <ol class="grid gap-4 @md:grid-cols-2 @4xl:grid-cols-5">
      {
        steps.map((s, i) => (
          <li class="group relative flex flex-col items-center rounded-2xl border border-white/10 bg-white/[0.05] p-6 text-center transition-colors hover:border-white/25 hover:bg-white/[0.08]">
            <span class="absolute right-4 top-4 font-heading text-sm font-bold text-[#ff8a5c]">
              {String(s.n).padStart(2, "0")}
            </span>
            <span class="mb-4 flex size-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[#ff6b35] to-[#9333ea] text-white shadow-lg shadow-black/30 ring-1 ring-white/10">
              <s.icon class="size-7" />
            </span>
            <h3 class="font-heading text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-snug text-white/60">{s.desc}</p>
            {i < steps.length - 1 && (
              <span class="absolute -right-3 top-1/2 z-10 hidden -translate-y-1/2 @4xl:block" aria-hidden="true">
                <span class="flex size-6 items-center justify-center rounded-full bg-[#ff6b35] text-white shadow-md">
                  <IconArrowRight class="size-3.5" />
                </span>
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
