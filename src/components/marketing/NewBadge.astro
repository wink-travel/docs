---
/**
 * Small brand-styled "NEW" badge for highlighting newly launched items
 * (cards, nav entries, etc.). Reusable across the marketing surface.
 * Composes the shared Starwind Badge (shape, sizing, focus ring) with the
 * brand gradient layered on via the `class` slot.
 */
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  /** Badge text. */
  label?: string;
  /** Extra classes appended to the badge. */
  class?: string;
}

const { label = "New", class: className = "" } = Astro.props;
---

<Badge
  size="sm"
  eyebrow
  class:list={["bg-gradient-to-r from-[#ff6b35] to-[#9333ea] font-bold text-white", className]}
>
  {label}
</Badge>
