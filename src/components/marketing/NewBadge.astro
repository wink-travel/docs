---
/**
 * Small brand-styled "NEW" badge for highlighting newly launched items
 * (cards, nav entries, etc.). Reusable across the marketing surface.
 */
interface Props {
  /** Badge text. */
  label?: string;
  /** Extra classes appended to the badge. */
  class?: string;
}

const { label = "New", class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full bg-gradient-to-r from-[#ff6b35] to-[#9333ea] px-2 py-0.5 text-[0.625rem] font-bold uppercase leading-none tracking-wider text-white",
    className,
  ]}
>
  {label}
</span>
