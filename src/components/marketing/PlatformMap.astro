---
import IconExtranet from "@/assets/product-icons/product-extranet.svg";
import IconStudio from "@/assets/product-icons/product-studio.svg";
import IconSocial from "@/assets/product-icons/product-social.svg";
import IconWinkLinks from "@/assets/product-icons/product-winklinks.svg";
import IconNetwork from "@/assets/product-icons/product-network.svg";
import IconAgentic from "@/assets/product-icons/product-agentic-ai.svg";
import IconBookingEngine from "@/assets/product-icons/product-booking-engine.svg";
import traveliko from "@/assets/product-icons/product-traveliko.png";
import apiIcon from "@/assets/product-icons/product-api.png";

interface Tile {
  name: string;
  href: string;
  icon?: any;
  img?: string;
  logoOnly?: boolean;
}

const layers: { label: string; tiles: Tile[] }[] = [
  { label: "Supply control", tiles: [{ name: "Extranet", href: "/products/extranet/", icon: IconExtranet }] },
  {
    label: "Demand surfaces",
    tiles: [
      { name: "Studio", href: "/products/studio/", icon: IconStudio },
      { name: "Social", href: "/products/social/", icon: IconSocial },
      { name: "WinkLinks", href: "/products/winklinks/", icon: IconWinkLinks },
    ],
  },
  {
    label: "Partner & consumer demand",
    tiles: [
      { name: "Network", href: "/products/studio/#partner-discovery", icon: IconNetwork },
      { name: "Traveliko", href: "/products/traveliko/", img: traveliko.src, logoOnly: true },
    ],
  },
  {
    label: "AI & platform access",
    tiles: [
      { name: "Agentic AI", href: "/agentic-ai/", icon: IconAgentic },
      { name: "Developers", href: "/dev/", img: apiIcon.src },
    ],
  },
];
---

<section class="@container mx-auto w-full max-w-7xl px-4 py-24">
  <div class="mx-auto mb-12 max-w-3xl text-center">
    <p class="mkt-kicker text-primary">Platform overview</p>
    <h2 class="mkt-h2 font-heading mt-3">
      One platform. Many demand routes. One fulfillment layer.
    </h2>
    <p class="mkt-sub text-muted-foreground mt-4">
      Hotels control supply. Partners and AI agents generate demand. Wink fulfills, attributes, and pays.
    </p>
  </div>

  <div class="rounded-3xl border border-border bg-gradient-to-b from-primary/[0.04] to-card p-4 shadow-sm @md:p-6">
    <div class="space-y-3">
      {
        layers.map((layer) => (
          <div class="rounded-2xl border border-border bg-card/70 p-4 @lg:flex @lg:items-center @lg:gap-5">
            <div class="mb-3 shrink-0 text-xs font-semibold uppercase tracking-wider text-primary @lg:mb-0 @lg:w-44">
              {layer.label}
            </div>
            <div class="flex flex-wrap gap-2.5">
              {layer.tiles.map((t) => (
                <a
                  href={t.href}
                  aria-label={t.name}
                  class="group inline-flex items-center gap-2.5 rounded-xl border border-border bg-background px-4 py-2.5 transition-colors hover:border-primary/40 hover:bg-muted"
                >
                  {t.logoOnly ? (
                    <img src={t.img} alt={t.name} class="h-11 w-auto shrink-0 object-contain" />
                  ) : (
                    <>
                      {t.img ? (
                        <img src={t.img} alt="" class="size-7 shrink-0 object-contain" />
                      ) : (
                        <t.icon class="size-7 shrink-0 text-primary" />
                      )}
                      <span class="text-sm font-semibold">{t.name}</span>
                    </>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {/* Foundation band — Booking Engine sits under every route */}
    <a
      href="/products/booking-engine/"
      class="group mt-3 flex flex-col gap-4 rounded-2xl bg-primary p-5 text-primary-foreground transition-colors hover:bg-primary/90 @lg:flex-row @lg:items-center @lg:gap-5"
    >
      <div class="flex shrink-0 items-center gap-4">
        <span class="flex size-12 items-center justify-center rounded-xl bg-white">
          <IconBookingEngine class="size-8" />
        </span>
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-primary-foreground/70">Fulfillment</div>
          <div class="font-heading text-lg font-semibold">Booking Engine</div>
        </div>
      </div>
      <p class="text-sm text-primary-foreground/90 @lg:ml-auto @lg:max-w-md @lg:text-right">
        Loads hotel data, takes payment, confirms, and completes the booking — under every route above.
      </p>
    </a>
  </div>
</section>
