---
/**
 * Entry-point promo card that funnels visitors to the dedicated
 * /travel-content-creators landing page. Drop it into any marketing page —
 * it renders its own centered section. Styled to match the site's cards.
 */
import IconUserStar from "@tabler/icons/outline/user-star.svg";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import NewBadge from "./NewBadge.astro";

interface Props {
  /** Extra classes for the outer section. */
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section class:list={["@container mx-auto w-full max-w-7xl px-4 py-12", className]}>
  <a
    href="/travel-content-creators/"
    class="group relative flex flex-col gap-6 overflow-hidden rounded-2xl border border-border bg-card p-8 transition-colors hover:border-primary/40 @lg:flex-row @lg:items-center @lg:justify-between"
  >
    <div
      class="pointer-events-none absolute -right-12 -top-12 size-52 rounded-full bg-gradient-to-br from-[#ff6b35]/15 to-[#9333ea]/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex items-start gap-5">
      <span
        class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-[#ff6b35] to-[#9333ea] text-white"
      >
        <IconUserStar class="size-7" />
      </span>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary">For Travel Creators</span>
          <NewBadge />
        </div>
        <h3 class="font-heading mt-1.5 text-xl font-semibold @lg:text-2xl">
          Turn your travel content into income.
        </h3>
        <p class="text-muted-foreground mt-2 max-w-xl text-pretty">
          Monetize your audience with commissions, booking storefronts, and full attribution.
          Built for creators of any size.
        </p>
      </div>
    </div>

    <span
      class="relative inline-flex h-11 shrink-0 items-center gap-1.5 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors group-hover:bg-primary/90"
    >
      Start earning
      <IconArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </a>
</section>
