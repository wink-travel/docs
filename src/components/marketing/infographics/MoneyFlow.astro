---
/**
 * MoneyFlow — "How the money moves" infographic.
 * Depicts the TripPay payout flow: guest pays in full → TripPay holds →
 * released to the hotel at check-in → partner split (only if applicable).
 * Used on: /products/booking-engine/ (section 5, "How payment works").
 *
 * ── SWAPPABLE INFOGRAPHIC ─────────────────────────────────────────────
 * This is a drop-in slot. To improve or replace the visual, edit ONLY the
 * body of this file — swap in a redesigned diagram, an inline <svg>, or an
 * <img src="/infographics/money-flow.svg" />. Keep the component name and the
 * outer <div> wrapper so pages using <MoneyFlow /> stay untouched.
 * ──────────────────────────────────────────────────────────────────────
 */
const steps = [
  { n: "1", t: "Guest pays in full at checkout", d: "The full booking amount is captured in the hotel-branded TripPay checkout." },
  { n: "2", t: "TripPay holds the funds", d: "Collected on behalf of the hotel, with policy and cancellation logic applied." },
  { n: "3", t: "Released at guest check-in", d: "Funds are paid out to the hotel at check-in, after Wink's all-in fee." },
  { n: "4", t: "Partner split — only if applicable", d: "Direct bookings have no partner. When a partner, creator or AI route created the booking, attribution and payout settle together." },
];
---

<div class="rounded-2xl border border-border bg-card p-6 shadow-sm @lg:p-8">
  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">How the money moves</p>
  <ol class="mt-5 space-y-5">
    {steps.map((s, i) => (
      <li class="flex gap-4">
        <div class="flex flex-col items-center">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#ff6b35] to-[#9333ea] text-sm font-bold text-white">{s.n}</span>
          {i < steps.length - 1 && <span class="mt-1 w-px flex-1 bg-border" aria-hidden="true"></span>}
        </div>
        <div class="pb-1">
          <p class="font-heading text-sm font-semibold text-foreground">{s.t}</p>
          <p class="text-muted-foreground mt-1 text-sm text-pretty">{s.d}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
