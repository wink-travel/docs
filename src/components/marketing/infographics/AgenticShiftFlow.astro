---
/**
 * AgenticShiftFlow — the "old way vs with Wink" before/after flow diagram.
 * Two node rows connected by arrows: the traveler-to-website path vs the
 * traveler-to-agent path where Wink API + Booking Engine are the commerce layer.
 * Used on: /agentic-ai/ ("The shift" section).
 *
 * ── SWAPPABLE INFOGRAPHIC ─────────────────────────────────────────────
 * Drop-in slot. To improve or replace the visual, edit ONLY the body of this
 * file — swap in a redesigned diagram, an inline <svg>, or an <img>. Keep the
 * component name so the page (which owns the section + heading) is untouched.
 * ──────────────────────────────────────────────────────────────────────
 */
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";

const oldWay = ["Traveler", "Website", "Search", "Compare", "Book"];
const withWink = ["Traveler", "AI agent", "Wink API", "Booking Engine", "Hotel"];
---

<div class="space-y-6">
  <div class="rounded-2xl border border-border bg-muted/30 p-6">
    <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">The old way</p>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      {oldWay.map((n, i) => (
        <>
          {i > 0 && <IconArrowRight class="size-4 shrink-0 text-muted-foreground/50" aria-hidden="true" />}
          <span class="rounded-lg border border-border bg-card px-3 py-2 font-medium text-muted-foreground">{n}</span>
        </>
      ))}
    </div>
  </div>
  <div class="rounded-2xl border-2 border-primary/30 bg-primary/[0.04] p-6">
    <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary">With Wink</p>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      {withWink.map((n, i) => (
        <>
          {i > 0 && <IconArrowRight class="size-4 shrink-0 text-primary/60" aria-hidden="true" />}
          <span class:list={["rounded-lg px-3 py-2 font-semibold", n === "Wink API" || n === "Booking Engine" ? "bg-primary text-primary-foreground" : "border border-primary/30 bg-card text-foreground"]}>{n}</span>
        </>
      ))}
    </div>
  </div>
</div>
