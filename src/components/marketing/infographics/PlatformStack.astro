---
/**
 * PlatformStack — the "your product brings the intent → Wink handles the
 * transaction → confirmed, paid booking" stack diagram.
 * Used on: /platforms/ (hero, right column).
 *
 * ── SWAPPABLE INFOGRAPHIC ─────────────────────────────────────────────
 * Drop-in slot. To improve or replace the visual, edit ONLY the body of this
 * file — swap in a redesigned diagram, an inline <svg>, or an <img>. Keep the
 * component name + outer wrapper so the hero layout stays untouched.
 * ──────────────────────────────────────────────────────────────────────
 */
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import IconBuildingStore from "@tabler/icons/outline/building-store.svg";
import IconCalendarStats from "@tabler/icons/outline/calendar-stats.svg";
import IconCalendarCheck from "@tabler/icons/outline/calendar-check.svg";
import IconTargetArrow from "@tabler/icons/outline/target-arrow.svg";
import IconCreditCard from "@tabler/icons/outline/credit-card.svg";
import IconWallet from "@tabler/icons/outline/wallet.svg";

const layers = [
  { icon: IconBuildingStore, label: "Inventory" },
  { icon: IconCalendarStats, label: "Availability & rates" },
  { icon: IconCalendarCheck, label: "Booking" },
  { icon: IconTargetArrow, label: "Attribution" },
  { icon: IconCreditCard, label: "Payments" },
  { icon: IconWallet, label: "Settlement" },
];
---

<div class="relative">
  <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl shadow-black/30 backdrop-blur @lg:p-7">
    <p class="text-xs font-semibold uppercase tracking-wider text-white/50">Your product brings the intent</p>
    <div class="mt-3 rounded-xl border border-dashed border-white/25 bg-white/[0.06] px-4 py-3 text-sm font-semibold text-white">AI assistant · LLM · agent · bank · super app</div>
    <div class="my-2 flex justify-center text-[#ff8a5c]"><IconArrowRight class="size-5 rotate-90" /></div>
    <p class="text-xs font-semibold uppercase tracking-wider text-[#ff8a5c]">Wink handles the transaction</p>
    <div class="mt-3 grid grid-cols-2 gap-2.5">
      {layers.map((s) => (
        <div class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.05] px-3 py-2 text-sm font-medium text-white/90">
          <span class="flex size-7 items-center justify-center rounded-md bg-gradient-to-br from-[#ff6b35] to-[#9333ea] text-white"><s.icon class="size-4" /></span>
          {s.label}
        </div>
      ))}
    </div>
    <div class="my-2 flex justify-center text-[#ff8a5c]"><IconArrowRight class="size-5 rotate-90" /></div>
    <div class="rounded-xl bg-gradient-to-r from-[#ff6b35] to-[#9333ea] px-4 py-3 text-center text-sm font-bold text-white">Confirmed, paid booking · hotel keeps control</div>
  </div>
</div>
