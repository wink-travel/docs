---
/**
 * Article + BreadcrumbList structured data for a Resources article.
 * Organization + WebSite already render site-wide via the footer; this adds the
 * per-article Article schema and the Home → Resources → <crumb> breadcrumb.
 * Pair with `<FaqGrid emitJsonLd ... />` for the FAQPage.
 *
 * URLs and `inLanguage` are derived from the current locale, so the French copy
 * of an article describes /fr/resources/<slug>/ in French rather than claiming
 * to be the English page. The `@id` references to #organization / #website stay
 * unprefixed on purpose: the footer emits those nodes with the same global ids
 * on every locale, so a localised reference here would dangle.
 */
import { withLocalePrefix } from "@/lib/locale-links";

interface Props {
  /** Article headline (the clean page title). */
  title: string;
  description: string;
  /** Resource slug, e.g. "direct-hotel-distribution". */
  slug: string;
  /** Visible breadcrumb leaf name (short). Defaults to title. */
  crumb?: string;
  /** schema.org Article subtype — e.g. "Report" for the research report. */
  articleType?: string;
  /** ISO date (YYYY-MM-DD). Optional — omit when the real date is unknown. */
  datePublished?: string;
  dateModified?: string;
}
const { title, description, slug, crumb, articleType = "Article", datePublished, dateModified } = Astro.props;

const { locale, lang } = Astro.locals.starlightRoute;

const SITE = "https://wink.travel";
const absolute = (path: string): string => new URL(withLocalePrefix(path, locale), SITE).href;

const url = absolute(`/resources/${slug}/`);
const image =
  "https://res.cloudinary.com/traveliko/image/upload/v1653294291/wink/wink-social-card.png";

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": articleType,
      "@id": `${url}#article`,
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      image,
      inLanguage: lang,
      ...(datePublished ? { datePublished } : {}),
      ...(datePublished || dateModified ? { dateModified: dateModified ?? datePublished } : {}),
      isPartOf: { "@id": "https://wink.travel/#website" },
      author: { "@id": "https://wink.travel/#organization" },
      publisher: { "@id": "https://wink.travel/#organization" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${url}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: absolute("/") },
        { "@type": "ListItem", position: 2, name: "Resources", item: absolute("/resources/") },
        { "@type": "ListItem", position: 3, name: crumb ?? title },
      ],
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
