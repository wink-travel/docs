---
import IconChevronDown from "@tabler/icons/outline/chevron-down.svg";

export interface FaqItem {
  title: string;
  content: string;
}

interface Props {
  heading?: string;
  description?: string;
  items?: FaqItem[];
  /** Emit FAQPage structured data from these items. Leave off on pages that
   *  already emit a FAQPage elsewhere (e.g. ProductJsonLd / FaqJsonLd). */
  emitJsonLd?: boolean;
}

const { heading, description, items = [], emitJsonLd = false } = Astro.props;

const faqJsonLd =
  emitJsonLd && items.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: items.map((f: FaqItem) => ({
          "@type": "Question",
          name: f.title,
          acceptedAnswer: { "@type": "Answer", text: f.content },
        })),
      }
    : null;
---

{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />}

<section class="@container mx-auto w-full max-w-7xl px-4 py-24">
  {(heading || description) && (
    <div class="mx-auto mb-12 max-w-2xl text-center">
      {heading && (
        <h2 class="mkt-h2 font-heading">{heading}</h2>
      )}
      {description && <p class="mkt-sub text-muted-foreground mt-3">{description}</p>}
    </div>
  )}

  <div class="grid gap-3 @md:grid-cols-2">
    {
      items.map((item) => (
        <details class="group rounded-xl border border-border bg-card transition-colors hover:border-primary/30 open:border-primary/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-semibold">
            <span>{item.title}</span>
            <IconChevronDown class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180" />
          </summary>
          <div class="text-muted-foreground px-4 pb-4 text-sm text-pretty">{item.content}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
