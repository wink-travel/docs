---
import IconCheck from "@tabler/icons/outline/check.svg";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";

export interface AudienceCard {
  eyebrow: string;
  title: string;
  valueProp: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
}

interface Props {
  heading?: string;
  intro?: string;
  cards?: AudienceCard[];
}

const { heading, intro, cards = [] } = Astro.props;
---

<section class="@container mx-auto w-full max-w-7xl px-4 py-24">
  {(heading || intro) && (
    <div class="mx-auto mb-16 max-w-3xl text-center">
      {heading && (
        <h2 class="font-heading text-3xl font-semibold tracking-tight @xl:text-4xl @3xl:text-5xl">
          {heading}
        </h2>
      )}
      {intro && <p class="text-muted-foreground mt-4 text-pretty @lg:text-lg">{intro}</p>}
    </div>
  )}

  <div class="grid gap-8 @2xl:grid-cols-3">
    {cards.map((card) => (
      <div class="flex flex-col rounded-2xl border-2 border-border bg-card p-8 transition-colors hover:border-primary/40">
        <span class="text-xs font-semibold uppercase tracking-wider text-primary">{card.eyebrow}</span>
        <h3 class="font-heading mt-3 text-2xl font-semibold">{card.title}</h3>
        <p class="text-muted-foreground mt-3 text-pretty">{card.valueProp}</p>
        <ul class="mt-6 space-y-3">
          {card.bullets.map((b) => (
            <li class="flex items-start gap-2.5">
              <IconCheck class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
              <span class="text-sm text-foreground/90">{b}</span>
            </li>
          ))}
        </ul>
        <a
          href={card.ctaHref}
          class="mt-8 inline-flex h-11 items-center justify-center gap-1.5 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          {card.ctaText}
          <IconArrowRight class="size-4" />
        </a>
      </div>
    ))}
  </div>
</section>
