---
/**
 * Solutions hero. Two columns: headline + CTAs on the left, and an animated
 * "four swimlanes" infographic on the right — one lane per stakeholder, each
 * with its OWN path and OWN payoff (hotels own & diversify distribution;
 * partners sell with tools & earn; creators monetize; devs/AI build on infra).
 * Each lane has its own accent colour and an animated connector flowing toward
 * the benefit. Deliberately divergent (four different solutions), the inverse of
 * the homepage's convergent supply hub. Lanes link to each audience page.
 * Reduced-motion respected.
 */
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";

// One swimlane per stakeholder: who they are → their distinct path → their
// distinct payoff. Each lane carries its own accent so the four read as four
// genuinely different solutions.
const solutions = [
  { emoji: "🏨", label: "Hotels", benefit: "Own & diversify your distribution", path: "Sell direct + across every channel", accent: "#ff6b35", href: "/hotels/" },
  { emoji: "🤝", label: "Partners", benefit: "Access hotels, sell with better tools, earn", path: "Eligible supply · links · storefronts · Web Components", accent: "#ec4899", href: "/partners/" },
  { emoji: "🎬", label: "Creators", benefit: "Monetize your audience", path: "Booking-ready storefronts via WinkLinks", accent: "#a855f7", href: "/travel-content-creators/" },
  { emoji: "🔌", label: "Developers & AI", benefit: "Build on top-tier booking infrastructure", path: "APIs · Agentic AI · Booking Engine", accent: "#22d3ee", href: "/dev/" },
];
---

<section
  data-solutions-hero
  class="@container relative w-full overflow-hidden border-b border-white/10 bg-gradient-to-br from-[#2a0f52] via-[#1f0a40] to-[#150629] text-white"
>
  <div data-parallax class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="blob blob-a absolute -left-24 -top-20 size-[30rem] rounded-full bg-[#ff6b35]/30 blur-[120px]"></div>
    <div class="blob blob-b absolute -bottom-24 right-0 size-[32rem] rounded-full bg-[#ec4899]/30 blur-[140px]"></div>
    <div class="blob blob-c absolute right-1/3 -top-10 size-80 rounded-full bg-[#22d3ee]/20 blur-[130px]"></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-7xl items-center gap-12 px-4 py-20 @xl:grid-cols-[1fr_1.05fr] @xl:py-24">
    {/* Left — copy */}
    <div class="text-center @xl:text-left">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-[#ff8a5c] ring-1 ring-white/15 backdrop-blur">
        <span class="size-1.5 animate-pulse rounded-full bg-gradient-to-r from-[#ff6b35] to-[#ec4899]"></span>
        Solutions
      </span>
      <h1 class="font-heading mt-6 text-5xl font-extrabold leading-[1.02] tracking-tight text-balance @lg:text-6xl">
        One platform. <span class="wink-shimmer bg-gradient-to-r from-[#ff8a5c] via-[#ec4899] to-[#a855f7] bg-clip-text text-transparent">Four ways to grow.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-pretty text-lg text-white/75 @xl:mx-0 @lg:text-xl">
        Wink connects hotel supply to every demand route — for hotels, partners, travel creators, and
        developers. Same platform, different job. Choose the path that matches your role.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 @xl:justify-start sm:flex-row">
        <a href="https://cal.com/wink-ws36dy" class="inline-flex h-14 w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ff6b35] to-[#ec4899] px-8 text-base font-extrabold text-white shadow-lg shadow-[#ec4899]/30 transition-transform hover:scale-[1.03] sm:w-auto">
          Request a demo <IconArrowRight class="size-5" />
        </a>
        <a href="/products/booking-engine/" class="inline-flex h-14 w-full items-center justify-center rounded-full bg-white/10 px-8 text-base font-bold text-white ring-1 ring-white/20 backdrop-blur transition-colors hover:bg-white/15 sm:w-auto">
          Explore Booking Engine
        </a>
      </div>
    </div>

    {/* Right — four swimlanes: one stakeholder per lane, each with its own path + payoff */}
    <div class="relative mx-auto w-full max-w-md">
      <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[3rem] bg-gradient-to-br from-[#ff6b35]/20 to-[#a855f7]/20 blur-2xl" aria-hidden="true"></div>
      <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5 shadow-2xl backdrop-blur @lg:p-6">
        <p class="text-center text-xs font-extrabold uppercase tracking-wider text-white/40">Everyone benefits</p>

        <div class="mt-4 grid auto-rows-fr gap-2.5">
          {solutions.map((s, i) => (
            <a
              href={s.href}
              class="ig-chip group flex h-full items-center gap-3 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.05] p-3 transition-colors hover:bg-white/[0.09]"
              style={`animation-delay:${0.15 + i * 0.12}s;border-left:3px solid ${s.accent}`}
            >
              {/* Who */}
              <div class="w-[4.5rem] shrink-0 text-center">
                <p class="text-xl leading-none" aria-hidden="true">{s.emoji}</p>
                <p class="mt-1 text-[0.7rem] font-bold leading-tight text-white/85">{s.label}</p>
              </div>

              {/* Animated connector */}
              <svg viewBox="0 0 32 12" class="h-3 w-7 shrink-0" aria-hidden="true">
                <line class="ig-flow" x1="1" y1="6" x2="31" y2="6" stroke={s.accent} stroke-width="2.5" stroke-linecap="round" />
              </svg>

              {/* What they get */}
              <div class="min-w-0 flex-1">
                <p class="text-sm font-extrabold leading-snug text-white">{s.benefit}</p>
                <p class="mt-0.5 text-[0.7rem] leading-snug text-white/55">{s.path}</p>
              </div>

              <IconArrowRight class="size-4 shrink-0 text-white/30 transition-transform group-hover:translate-x-0.5" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes sol-floaty {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(36px, -26px) scale(1.12); }
    66% { transform: translate(-26px, 22px) scale(0.92); }
  }
  .blob-a { animation: sol-floaty 20s ease-in-out infinite; }
  .blob-b { animation: sol-floaty 26s ease-in-out infinite reverse; }
  .blob-c { animation: sol-floaty 30s ease-in-out infinite; }

  @keyframes ig-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .ig-chip { opacity: 0; animation: ig-in 0.5s ease-out forwards; }
  .ig-node { opacity: 0; animation: ig-in 0.6s ease-out 0.95s forwards; }
  .ig-arrow { opacity: 0; animation: ig-in 0.4s ease-out 1.3s forwards; }
  .ig-out { opacity: 0; animation: ig-in 0.6s ease-out 1.5s forwards; }

  @keyframes ig-flow-move { to { stroke-dashoffset: -28; } }
  .ig-flow { stroke-dasharray: 5 7; animation: ig-flow-move 1.4s linear infinite; }

  [data-parallax] { transition: transform 0.3s ease-out; will-change: transform; }

  @media (prefers-reduced-motion: reduce) {
    .blob-a, .blob-b, .blob-c, .ig-flow { animation: none; }
    .ig-chip, .ig-node, .ig-arrow, .ig-out { opacity: 1; animation: none; }
    [data-parallax] { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-solutions-hero]");
  const parallax = root && root.querySelector<HTMLElement>("[data-parallax]");
  if (root && parallax && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    root.addEventListener("mousemove", (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      parallax.style.transform = `translate(${x * 26}px, ${y * 26}px)`;
    });
    root.addEventListener("mouseleave", () => {
      parallax.style.transform = "";
    });
  }
</script>
