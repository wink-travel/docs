---
/**
 * FAQPage structured data for non-product marketing pages (audience / hub pages).
 * Organization + WebSite already render site-wide via the footer, so this emits
 * just the FAQPage. Pass the same `faqs` array the page renders so the two match.
 */
import { faqsToMainEntity, type Faq } from "@/lib/faq-schema";
const { faqs = [] as Faq[] } = Astro.props;

const data = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqsToMainEntity(faqs),
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
