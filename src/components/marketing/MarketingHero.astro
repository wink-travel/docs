---
/**
 * Centered marketing hero matching the bespoke gradient template used across
 * the Solutions sub-pages (Hotels / Partners / Developers / About):
 * gradient pill badge + headline with an optional gradient accent + sub + CTAs.
 * Use on hub / overview pages that don't have a single device-frame visual.
 */
interface Props {
  badge?: string;
  heading: string;
  /** Optional second part of the headline, rendered in the orange→purple gradient. */
  accent?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}
const {
  badge,
  heading,
  accent,
  description,
  primaryText,
  primaryHref,
  secondaryText,
  secondaryHref,
} = Astro.props;
---

<section class="@container mx-auto w-full max-w-4xl px-4 pb-16 pt-16 text-center @lg:pt-24">
  {badge && (
    <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-gradient-to-r from-[#ff6b35]/10 to-[#9333ea]/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary">
      <span class="size-1.5 rounded-full bg-gradient-to-r from-[#ff6b35] to-[#9333ea]"></span>
      {badge}
    </span>
  )}
  <h1 class="font-heading mx-auto mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-balance @lg:text-5xl @2xl:text-[3.5rem] @2xl:leading-[1.05]">
    {heading}
    {accent && (
      <> <span class="bg-gradient-to-r from-[#ff6b35] to-[#9333ea] bg-clip-text text-transparent">{accent}</span></>
    )}
  </h1>
  {description && (
    <p class="text-muted-foreground mx-auto mt-6 max-w-2xl text-pretty text-lg @lg:text-xl">{description}</p>
  )}
  {(primaryText || secondaryText) && (
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      {primaryText && (
        <a href={primaryHref} class="inline-flex h-12 w-full items-center justify-center rounded-md bg-primary px-7 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:w-auto">{primaryText}</a>
      )}
      {secondaryText && (
        <a href={secondaryHref} class="inline-flex h-12 w-full items-center justify-center rounded-md border border-border px-7 text-base font-medium transition-colors hover:bg-muted sm:w-auto">{secondaryText}</a>
      )}
    </div>
  )}
</section>
