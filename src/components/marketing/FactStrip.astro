---
interface Props {
  items?: string[];
  note?: string;
}

const { items = [], note } = Astro.props;
---

<section class="@container mx-auto w-full max-w-7xl px-4">
  <div class="rounded-2xl border border-primary/20 bg-primary/5 px-6 py-6">
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center">
      {items.map((item, i) => (
        <>
          {i > 0 && <span class="text-primary/40" aria-hidden="true">·</span>}
          <span class="text-sm font-semibold text-foreground @lg:text-base">{item}</span>
        </>
      ))}
    </div>
    {note && <p class="mt-3 text-center text-xs text-muted-foreground">{note}</p>}
  </div>
</section>
