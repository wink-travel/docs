---
import IconCheck from "@tabler/icons/outline/check.svg";
import IconInfoCircle from "@tabler/icons/outline/info-circle.svg";

interface Props {
  items?: string[];
  note?: string;
}

const { items = [], note } = Astro.props;
---

<section class="@container mx-auto w-full max-w-7xl px-4">
  <div
    class="rounded-3xl border border-primary/15 bg-gradient-to-br from-primary/[0.07] via-card to-card p-5 shadow-sm @md:p-7"
  >
    <ul
      class="grid list-none grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-3 p-0 @md:gap-4"
    >
      {
        items.map((item) => (
          <li class="group flex flex-col items-center gap-3 rounded-2xl border border-border bg-card p-5 text-center shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
            <span class="flex size-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#ff6b35] to-[#9333ea] text-white shadow-sm">
              <IconCheck class="size-5" aria-hidden="true" />
            </span>
            <span class="text-sm font-semibold leading-snug text-pretty text-foreground @md:text-base">
              {item}
            </span>
          </li>
        ))
      }
    </ul>

    {
      note && (
        <p class="mx-auto mt-6 flex max-w-3xl items-start justify-center gap-2 border-t border-primary/10 pt-5 text-center text-xs text-muted-foreground @md:text-sm">
          <IconInfoCircle class="mt-0.5 size-4 shrink-0 text-primary/60" aria-hidden="true" />
          <span class="text-left">{note}</span>
        </p>
      )
    }
  </div>
</section>
