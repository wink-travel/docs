---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  heading?: string;
  stats?: Stat[];
  note?: string;
}

const {
  heading,
  stats = [],
  note,
} = Astro.props;
---

<section class="@container mx-auto w-full max-w-7xl px-4 py-16">
  {heading && (
    <p class="mkt-kicker mb-10 text-center text-primary">{heading}</p>
  )}
  <div class="grid grid-cols-2 gap-4 @lg:grid-cols-4">
    {
      stats.map((s) => (
        <div class="rounded-2xl border border-border bg-card p-6 text-center">
          <div class="mkt-h2 font-heading text-primary">
            {s.value}
          </div>
          <div class="text-muted-foreground mt-2 text-sm text-pretty">{s.label}</div>
        </div>
      ))
    }
  </div>
  {note && <p class="text-muted-foreground mt-6 text-center text-xs">{note}</p>}
</section>
