---
/**
 * Tablist and behaviour for /legal/payment-terms/.
 *
 * Lives in a component rather than inline in the MDX because MDX parses `{` as
 * the start of a JSX expression, including inside <script> — the tab script
 * cannot be authored in the page itself.
 *
 * The three panels are rendered by the page and located here by id. All of them
 * stay in the DOM, hidden with the `hidden` attribute rather than mounted on
 * demand, so crawlers and answer engines see the full text of all three
 * agreements rather than only the open one.
 */
const tabs = [
  { code: "accommodation-provider", label: "Accommodation Provider", note: "TripPay collects for the hotel" },
  { code: "demand-partner", label: "Demand Partner", note: "Commission settlement" },
  { code: "agent-collected", label: "Agent-Collected Channel", note: "The travel agent collects" },
];
---

<nav aria-label="Choose your payment route" class="mt-6">
  <div role="tablist" class="grid gap-2 sm:grid-cols-3">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.code}`}
          aria-controls={`panel-${t.code}`}
          aria-selected={i === 0 ? "true" : "false"}
          data-tab={t.code}
          class={`flex flex-col rounded-xl border px-4 py-3 text-left transition-colors ${
            i === 0
              ? "border-primary bg-primary/[0.06] text-foreground"
              : "border-border text-muted-foreground hover:border-primary/40 hover:text-foreground"
          }`}
        >
          <span class="text-sm font-semibold">{t.label}</span>
          <span class="mt-0.5 text-xs text-muted-foreground">{t.note}</span>
        </button>
      ))
    }
  </div>
</nav>

<script is:inline>
  (function () {
    var root = document.getElementById("payment-terms-panels");
    var tabs = Array.prototype.slice.call(document.querySelectorAll("[data-tab]"));
    if (!root || !tabs.length) return;
    var panels = Array.prototype.slice.call(root.querySelectorAll("[data-panel]"));

    function select(code, push) {
      if (!document.getElementById("panel-" + code)) return;
      tabs.forEach(function (t) {
        var on = t.getAttribute("data-tab") === code;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.classList.toggle("border-primary", on);
        t.classList.toggle("bg-primary/[0.06]", on);
        t.classList.toggle("text-foreground", on);
        t.classList.toggle("border-border", !on);
        t.classList.toggle("text-muted-foreground", !on);
      });
      panels.forEach(function (p) {
        p.hidden = p.getAttribute("data-panel") !== code;
      });
      if (push) history.replaceState(null, "", "#" + code);
    }

    tabs.forEach(function (t) {
      t.addEventListener("click", function () {
        select(t.getAttribute("data-tab"), true);
      });
    });

    // Deep links work two ways: #demand-partner opens that tab, and a clause
    // link such as #dp-4-payout opens the tab that owns the clause and scrolls
    // to it. The per-document anchor prefixes are what make the second possible.
    function fromHash() {
      var h = (location.hash || "").replace(/^#/, "");
      if (!h) return;
      if (document.getElementById("panel-" + h)) {
        select(h, false);
        return;
      }
      var el = document.getElementById(h);
      if (!el) return;
      var panel = el.closest("[data-panel]");
      if (panel) {
        select(panel.getAttribute("data-panel"), false);
        el.scrollIntoView();
      }
    }

    fromHash();
    window.addEventListener("hashchange", fromHash);
  })();
</script>
