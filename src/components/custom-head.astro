---
import Default from "@astrojs/starlight/components/Head.astro";
import DocsBreadcrumbJsonLd from "@/components/marketing/DocsBreadcrumbJsonLd.astro";
import { isNoindexChangelogPage } from "@/lib/changelog-noindex.mjs";

// Per-page Open Graph image: default-locale marketing pages get a generated
// OG card (/og/<id>.png); everything else falls back to the global social card.
const route = Astro.locals.starlightRoute;
const id = route?.entry?.id ?? "";
const isMarketing = route?.entry?.data?.marketingNav === true;
const isDefaultLocale = !/^[a-z]{2}(-[a-z]+)?\//i.test(id);

const fallback =
  "https://res.cloudinary.com/traveliko/image/upload/v1653294291/wink/wink-social-card.png";
// Starlight normalizes the collection root's id from "index" to "" (see its
// normalizeIndexSlug), but the /og/[...slug].ts route builds its pages from
// the raw, unnormalized collection id, so the homepage's card is generated at
// /og/index.png. Map "" back to "index" or the homepage card 404s.
const ogSlug = id === "" ? "index" : id;
const ogImage =
  isMarketing && isDefaultLocale
    ? new URL(`/og/${ogSlug}.png`, Astro.site).href
    : fallback;

// Every changelog page is noindex,nofollow and out of the sitemap (see
// astro.config.mjs and changelog-noindex.mjs). They only show recent release
// entries, so they stay readable and linkable but are not submitted for
// indexing, and their links are not followed.
const isChangelog = isNoindexChangelogPage(Astro.url.pathname);
---

<Default />
<meta property="og:image" content={ogImage} />
<meta name="twitter:image" content={ogImage} />
{isChangelog && <meta name="robots" content="noindex,nofollow" />}
<DocsBreadcrumbJsonLd />
