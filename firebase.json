{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": "contactForm"
      }
    ],
    "redirects": [
      {
        "source": "/travel-content-creators{,/**}",
        "destination": "/travel-creators/",
        "type": 301
      },
      {
        "source": "/:locale/travel-content-creators{,/**}",
        "destination": "/:locale/travel-creators/",
        "type": 301
      },
      {
        "source": "/dev{,/**}",
        "destination": "/builders/",
        "type": 301
      },
      {
        "source": "/:locale/dev{,/**}",
        "destination": "/:locale/builders/",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ]
}
