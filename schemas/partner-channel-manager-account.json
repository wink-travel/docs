          },
          "currency": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "PropertyRateUpdateRequest": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          },
          "currencyCode": {
            "type": "string"
          },
          "master": {
            "type": "boolean"
          },
          "closedOnArrival": {
            "type": "boolean"
          },
          "closedOnDeparture": {
            "type": "boolean"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "minLengthOfStay": {
            "type": "integer",
            "format": "int32"
          },
          "maxLengthOfStay": {
            "type": "integer",
            "format": "int32"
          },
          "minOccupancy": {
            "type": "integer",
            "format": "int32"
          },
          "maxOccupancy": {
            "type": "integer",
            "format": "int32"
          },
          "singleOccupancyRateModifier": {
            "$ref": "#/components/schemas/VariableCharge"
          },
          "extraPaxRateModifier": {
            "$ref": "#/components/schemas/VariableCharge"
          },
          "extraChildRateModifier": {
            "$ref": "#/components/schemas/VariableCharge"
          }
        },
        "required": [
          "endDate",
          "startDate"
        ]
      },
      "VariableCharge": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "",
            "description": "When the type is FIXED, fixedAmount is required. When the type is PERCENTAGE, percent is required.",
            "enum": [
              "FIXED",
              "PERCENTAGE"
            ]
          },
          "percent": {
            "type": "number",
            "format": "float",
            "default": "",
            "description": "A percentage of the total stay amount for an early check-in or late check-out",
            "example": 0.25
          },
          "fixedAmount": {
            "$ref": "#/components/schemas/CustomMonetaryAmount",
            "default": "",
            "description": "A localized amount"
          }
        },
        "required": [
          "type"
        ]
      },
      "PropertyRate": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "propertyIdentifier": {
            "type": "string",
            "minLength": 1
          },
          "roomRateIdentifier": {
            "type": "string",
            "minLength": 1
          },
          "guestRoomIdentifier": {
            "type": "string",
            "minLength": 1
          },
          "ratePlanIdentifier": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
