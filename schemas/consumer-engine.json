  "components": {
    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "Child_Non_Authenticated_Entity": {
        "type": "object",
        "default": null,
        "description": "BookingItineraryRoomConfigurationChild configuration",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "Number of children",
            "minimum": 1
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "Age of children",
            "minimum": 0
          }
        },
        "required": [
          "age",
          "quantity"
        ]
      },
      "CustomizationClient_Non_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "format": "uuid",
            "default": "",
            "description": "Unique customization configuration identifier",
            "example": "customization-configuration-1"
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "Engine configuration name",
            "example": "Engine Configuration 1",
            "minLength": 1
          },
          "appendToPageTitle": {
            "type": "string",
            "default": "",
            "description": "Whether to append text to the existing booking customization page title."
          },
          "ownerIdentifier": {
            "type": "string",
            "format": "uuid",
            "default": "",
            "description": "Engine configuration record creator identifier",
            "example": "company-1"
          },
          "ownerName": {
            "type": "string",
            "default": "",
            "description": "Name of company owner.",
            "example": "Travel Tech 1"
          },
          "subType": {
            "type": "string",
            "default": "",
            "description": "Sales channel sub-type.",
            "enum": [
              "TRIP_PAY",
              "FACILITATOR",
              "DIRECT",
              "APPLICATION",
              "HOTEL",
              "TRAVELIKO",
              "CORPORATE",
              "TRAVEL_AGENT",
              "INFLUENCER",
              "BLOGGER",
              "DESTINATION",
              "CHANNEL_MANAGER",
              "PROPERTY_MANAGEMENT_SYSTEM",
              "CENTRAL_RESERVATION_SYSTEM",
              "GOOGLE_HOTEL_API",
              "MANAGEMENT_COMPANY",
              "CHAIN",
              "BRAND",
              "EVENT_ORGANIZER",
              "OTHER"
            ],
            "example": "APPLICATION"
          },
          "primary": {
            "type": "boolean",
            "default": false,
            "description": "Indicates whether this configuration is primary. A primary configuration cannot be removed.",
            "example": true
          },
          "googleAnalyticsMeasurementId": {
            "type": "string",
            "default": "",
            "description": "If you want to track analytics with Google Analytics using your GA4 Measurement ID."
          },
          "googleTagManagerContainerId": {
            "type": "string",
            "default": "",
            "description": "If you want to track analytics and you have a GTM Container ID, enter it here."
          },
          "googleMapsAPIKey": {
            "type": "string",
            "default": "",
            "description": "If you want your users to see Google Maps in your hosted booking customization, go to [Google Maps](https://console.developers.google.com/projectselector2/apis/credentials?supportedpurview=project) and create an API key for your site.",
            "example": "google-maps-api-123"
          },
          "defaultCurrency": {
            "type": "string",
            "default": "USD",
            "description": "Control which currency your users see prices in initially.",
            "example": "USD"
          },
          "defaultLanguage": {
            "type": "string",
            "default": "en",
            "description": "Control which language your users see text in initially.",
            "example": "en"
          },
          "logoImageIdentifier": {
            "type": "string",
            "default": "",
            "description": "Customize booking confirmation emails by adding a custom logo to your configuration."
          },
          "hostedBookingEngineUrl": {
            "type": "string",
            "default": "https://ota.wink.travel",
            "description": "If you are self-hosting our booking customization, let us know where it is hosted. Note: This url needs to be secured with SSL.",
            "example": "https://my.customtravelsite.com/book"
          },
          "selfHosted": {
            "type": "boolean",
            "default": false,
            "description": "Flag to indicate you are self-hosting our booking customization and not using our default booking customization url.",
            "example": true
          },
          "themeColors": {
            "$ref": "#/components/schemas/CustomizationThemeColors_Non_Authenticated_Entity",
            "default": "",
            "description": "Choose how you want our web components to look and more closely match with your own site style."
          },
          "numberOfAdvanceDays": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "You can control the initial itinerary date used to retrieve travel inventory prices. You can do it in one of two ways: 1. Dynamically set the date by indicating how long and how many days in advance (this field), of today's date, you want to display prices for. 2. Set a fixed date to display prices for. Option 1 is the most shared. Option 2 is for when you want to create a new customization and apply it to a specific event that occurs on a specific date. If you don't use either of these options, the itinerary will default to today's date with one night stay. ONLY populate this field if you want to control the itinerary date. Also, leave `startDate` and `endDate` empty.",
            "example": 10
          },
          "numberOfStayDays": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "You can control the initial itinerary date used to retrieve travel inventory prices. You can do it in one of two ways: 1. Dynamically set the date by indicating how long (this field) and how many days in advance, of today's date, you want to display prices for. 2. Set a fixed date to display prices for. Option 1 is the most shared. Option 2 is for when you want to create a new customization and apply it to a specific event that occurs on a specific date. If you don't use either of these options, the itinerary will default to today's date with one night stay. ONLY populate this field if you want to control the itinerary date. Also, leave `startDate` and `endDate` empty.",
            "example": 2
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "default": "",
            "description": "Set a fixed itinerary start date. ONLY populate this field if you want to fix the itinerary date. Also, leave `numberOfAdvanceDays` and `numberOfStayDays` empty.",
            "example": "2021-12-24"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "default": "",
            "description": "Set a fixed itinerary end date ONLY populate this field if you want to fix the itinerary date. Also, leave `numberOfAdvanceDays` and `numberOfStayDays` empty.",
            "example": "2021-12-31"
          },
          "roomConfigurations": {
            "type": "array",
            "default": "",
            "description": "Control how many adults / children will be staying and how many rooms. Defaults to: One room, two adults.",
            "items": {
              "$ref": "#/components/schemas/RoomConfiguration_Non_Authenticated_Entity"
            }
          },
          "useDays": {
            "type": "boolean",
            "default": false,
            "description": "if true, we use numberOfAdvanceDays / numberOfStayDays properties - false, we use startDate / endDate",
            "example": true
          },
          "promotionalCodes": {
            "type": "array",
            "default": "",
            "description": "If you've received special promotional codes from suppliers to give to your audience, you can choose to bake these code directly into the price by entering them here.",
            "example": [
              "promo-1"
            ],
            "items": {
              "type": "string"
            }
          },
          "wcBookClickAction": {
            "type": "string",
            "default": "",
            "description": "Action to complete once a user clicks on the CTA button on inventory.",
            "enum": [
              "FORWARD_TO_IBE",
              "IBE_MODAL"
            ],
            "example": "IBE_MODAL"
          },
          "showUnavailableCard": {
            "type": "boolean",
            "default": false,
            "description": "Show unavailable inventory card when inventory not currently for sale. Otherwise, it displays a normal card but without the price."
          },
          "showRankings": {
            "type": "boolean",
            "default": false,
            "description": "Whether to display rankings (lifestyle, eco score and reviews) on hotel landing page."
          },
          "showSearch": {
            "type": "boolean",
            "default": false,
            "description": "This feature flag controls whether to let a user move away from the hotel landing page using search."
          },
          "layout": {
            "type": "string",
            "default": "INFORMATIONAL",
            "description": "Choose how you want our web component cards laid out.",
            "enum": [
              "INFORMATIONAL",
              "TRANSACTIONAL"
            ],
            "example": "INFORMATIONAL"
          },
          "cardLayout": {
            "type": "string",
            "default": "VERTICAL",
            "description": "Choose how you large you want our web component cards to be.",
            "enum": [
              "HORIZONTAL",
              "VERTICAL"
            ],
            "example": "VERTICAL"
          },
          "trackingPixels": {
            "type": "array",
            "default": "",
            "description": "Tracking pixels to fire on key booking events.",
            "items": {
              "$ref": "#/components/schemas/TrackingPixel_Non_Authenticated_Entity"
            }
          },
