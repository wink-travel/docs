  "components": {
    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "LeaderboardOwnerRequest_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "currencyCode": {
            "type": "string",
            "default": "USD",
            "description": "Display leaderboard values in this currency",
            "example": "USD",
            "minLength": 1
          },
          "ownerIdentifier": {
            "type": "string",
            "format": "uuid",
            "default": "",
            "description": "The company you wish to track on a leaderboard",
            "example": "company-1",
            "minLength": 1
          }
        },
        "required": [
          "currencyCode",
          "ownerIdentifier"
        ]
      },
      "BookingLeaderboardEntry_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "ownerIdentifier": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "continent": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "countryGeoNameId": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "cityGeoNameId": {
            "type": "string"
          },
          "bookings": {
            "type": "integer",
            "format": "int64"
          },
          "totalPriceAmount": {
            "type": "number"
          },
          "averageBookingAmount": {
            "type": "number"
          },
          "currencyCode": {
            "type": "string"
          }
        }
      },
      "LeaderboardRequest_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "Which page to access in the record set",
            "example": 0,
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "default": 100,
            "description": "Number of result set to retrieve",
            "example": 20,
            "maximum": 100
          },
          "currencyCode": {
            "type": "string",
            "default": "USD",
            "description": "Display leaderboard values in this currency",
            "example": "USD",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "default": "GLOBAL",
            "description": "The type of leaderboard to display",
            "enum": [
              "GLOBAL",
              "CONTINENT",
              "COUNTRY",
              "CITY"
            ],
            "example": "GLOBAL"
          },
          "groupingIdentifier": {
            "type": "string",
            "default": "",
            "description": "Can be `continent`, `country.geoNameId` or `city.geoNameId`",
            "example": "654321"
          }
        },
        "required": [
          "currencyCode",
          "page",
          "size",
          "type"
        ]
      },
      "PageBookingLeaderboardEntry_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingLeaderboardEntry_Authenticated_Entity"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject_Authenticated_Entity"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject_Authenticated_Entity"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "PageableObject_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject_Authenticated_Entity"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "paged": {
            "type": "boolean"
          },
          "unpaged": {
            "type": "boolean"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SortObject_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      },
      "AggregateDescriptor_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "default": "",
            "description": "Field to run aggregate function on",
            "example": "hotel.bookings"
          },
          "aggregate": {
            "type": "string",
            "default": "",
            "description": "Aggregate function",
            "enum": [
              "count",
              "sum",
              "average",
              "min",
              "max"
            ],
            "example": "count"
          }
        }
      },
      "CompositeFilterDescriptor_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "logic": {
            "type": "string",
            "default": "",
            "description": "Whether to filter inclusively or exclusively",
            "enum": [
              "and",
              "or"
            ],
            "example": "and"
          },
          "filters": {
            "type": "array",
            "default": "",
            "description": "Descriptors used for filtering the result set",
            "items": {
              "$ref": "#/components/schemas/FilterDescriptor_Authenticated_Entity"
            }
          }
        }
      },
      "FilterDescriptor_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "default": "",
            "description": "Field name to filter on",
            "example": "hotel.name",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "default": "",
            "description": "Filter operator to use on field",
            "enum": [
              "neq",
              "eq",
              "contains",
              "doesnotcontain",
              "isnull",
              "isnotnull",
              "isempty",
              "isnotempty",
              "startswith",
              "endswith",
              "gte",
              "lte",
              "gt",
              "lt",
              "in",
              "nin"
            ],
            "example": "startsWith"
          },
          "value": {
            "default": "",
            "description": "Value to filter dataset against",
            "example": "Happy Res"
          },
          "ignoreCase": {
            "type": "boolean",
            "default": false,
            "description": "Make filter comparison case insensitive. Default: Case sensitive ",
            "example": true
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "GroupDescriptor_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "default": "",
            "description": "Field to group data set on",
            "example": "createdDate"
          },
          "dir": {
            "type": "string",
            "default": "",
            "description": "Group sort direction",
            "enum": [
              "asc",
              "desc"
            ],
            "example": "asc"
          },
          "aggregates": {
            "type": "array",
            "default": "",
            "description": "Primitive aggregate data points",
            "items": {
              "$ref": "#/components/schemas/AggregateDescriptor_Authenticated_Entity"
            }
          }
        }
      },
      "SortDescriptor_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "dir": {
            "type": "string",
            "default": "",
            "description": "Descriptors used for sorting result set",
            "enum": [
              "asc",
              "desc"
            ],
            "example": "asc"
          },
          "field": {
            "type": "string",
            "default": "",
            "description": "Data set field to sort on",
            "example": "hotel.name"
          }
        }
      },
      "State_Authenticated_Entity": {
        "type": "object",
        "properties": {
          "skip": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "Number of records to be skipped by the pager.",
            "example": 0,
            "minimum": 0
          },
          "take": {
            "type": "integer",
            "format": "int32",
            "default": 30,
            "description": "Number of records to take.",
            "example": 10,
            "maximum": 180,
            "minimum": 1
          },
          "sort": {
            "type": "array",
            "default": "",
            "description": "Descriptors used for sorting result set.",
            "items": {
              "$ref": "#/components/schemas/SortDescriptor_Authenticated_Entity"
            }
          },
          "filter": {
            "$ref": "#/components/schemas/CompositeFilterDescriptor_Authenticated_Entity",
            "default": "",
            "description": "Descriptors used for filtering result set"
