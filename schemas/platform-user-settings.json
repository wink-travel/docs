  "components": {
    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "MediaAuthorAttribution": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "default": "",
            "description": "URL to contributor",
            "example": "https://maps.google.com/maps/contrib/111628493169070103594"
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "Name of contributor",
            "example": "Samuel Adams",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "SimpleDescription": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Use as title or short text description",
            "example": "An example title"
          },
          "description": {
            "type": "string",
            "default": "",
            "description": "Longer text description",
            "example": "This is a longer description in the specified language.",
            "maxLength": 2147483647,
            "minLength": 1
          },
          "language": {
            "type": "string",
            "default": "en",
            "description": "Indicate which language this description is written in.",
            "example": "en",
            "maxLength": 2,
            "minLength": 2
          },
          "creator": {
            "type": "string",
            "default": "USER",
            "description": "Whether it was user or system generated.",
            "enum": [
              "SYSTEM",
              "USER"
            ],
            "example": "SYSTEM"
          },
          "md5ContentHash": {
            "type": "string",
            "default": "",
            "description": "The md5 hash of the name, description and language."
          },
          "hashMismatch": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "required": [
          "description",
          "language",
          "name"
        ]
      },
      "SimpleMultimedia": {
        "type": "object",
        "default": null,
        "description": "Multimedia that contains less information than Multimedia object",
        "properties": {
          "multimediaIdentifier": {
            "type": "string",
            "format": "uuid",
            "default": "",
            "description": "Document identifier",
            "example": "image-1",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "default": "",
            "description": "Use this identifier to communicate with Cloudinary.",
            "example": "cloudinary-image-1",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "default": "",
            "description": "Whether Cloudinary media is a VIDEO or IMAGE.",
            "enum": [
              "IMAGE",
              "VIDEO",
              "AUDIO",
              "RAW"
            ],
            "example": "IMAGE"
          },
          "source": {
            "type": "string",
            "default": "CLOUDINARY",
            "description": "Currently ONLY using Cloudinary to store all image / video assets.",
            "enum": [
              "YOUTUBE",
              "CLOUDINARY"
            ],
            "example": "CLOUDINARY"
          },
          "sort": {
            "type": "integer",
            "format": "int32",
            "default": 999,
            "description": "Sort allows you to control how you want to sort this record in a list of media records.",
            "example": 10
          },
          "angle": {
            "type": "string",
            "default": "",
            "description": "Media angle",
            "example": "-90"
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "Media width in pixels.",
            "example": 2560,
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "Media height in pixels.",
            "example": 1600,
            "minimum": 1
          },
          "published": {
            "type": "boolean",
            "default": false,
            "description": "Instead of deleting the media, choose to un-publish it instead for later re-use. Could be you keep seasonal images of the property.",
            "example": true
          },
          "category": {
            "type": "string",
            "default": "",
            "description": "Supported OTA specification `PIC` code. See [OTA geoname data](#operation/showAvailableCodesForCategory)",
            "example": "1"
          },
          "descriptions": {
            "type": "array",
            "default": "",
            "description": "Localized media captions to give user some context about where this media was taken.",
            "items": {
              "$ref": "#/components/schemas/SimpleDescription"
            }
          },
          "lifestyleType": {
            "type": "string",
            "default": "",
            "description": "Associate this media with a specific lifestyle type. A user searching and filtering inventory based on lifestyles can be shown relevant media first.",
            "enum": [
              "LIFESTYLE_HEALTH_FITNESS",
              "LIFESTYLE_RELAX",
              "LIFESTYLE_ADULT_ONLY",
              "LIFESTYLE_ADVENTURE",
              "LIFESTYLE_BUSINESS",
              "LIFESTYLE_LGBT",
              "LIFESTYLE_SINGLE_PARENT",
              "LIFESTYLE_SOLO_FEMALE",
              "LIFESTYLE_BEAUTY",
              "LIFESTYLE_FOODIE",
              "LIFESTYLE_FAMILY",
              "LIFESTYLE_ROMANCE",
              "LIFESTYLE_COUPLE",
              "LIFESTYLE_SOLO",
              "LIFESTYLE_BACKPACKER",
              "LIFESTYLE_SHOPPING",
              "LIFESTYLE_SPORTS",
              "LIFESTYLE_MOUNTAIN",
              "LIFESTYLE_BEACH",
              "LIFESTYLE_CITY",
              "LIFESTYLE_COUNTRY",
              "LIFESTYLE_CULTURE",
              "LIFESTYLE_ECO"
            ],
            "example": "LIFESTYLE_HEALTH_FITNESS"
          },
          "attribution": {
            "type": "array",
            "default": "",
            "description": "Whether image has attribution properties",
            "items": {
              "$ref": "#/components/schemas/MediaAuthorAttribution"
            }
          },
          "isLandscape": {
            "type": "boolean",
            "default": false,
            "description": "True if media width is greater or equal to height",
            "example": true
          }
        },
        "required": [
          "height",
          "identifier",
          "multimediaIdentifier",
          "sort",
          "source",
          "type",
          "width"
        ]
      },
      "UpsertUserProfileRequest": {
        "type": "object",
        "default": null,
        "description": "User profile information",
        "properties": {
          "firstName": {
            "type": "string",
            "default": "",
            "description": "First name",
            "example": "Jane",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "default": "",
            "description": "Last name",
            "example": "Doe",
            "minLength": 1
          },
          "username": {
            "type": "string",
            "default": "",
            "description": "Unique user email",
            "example": "jane@doe.com",
            "minLength": 1
          },
          "profilePicture": {
            "$ref": "#/components/schemas/SimpleMultimedia",
            "default": "",
            "description": "Profile picture that originates from a Cloudinary upload"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "username"
        ]
      },
      "UpsertUserProfileResponse": {
        "type": "object",
        "default": null,
        "description": "User profile information",
        "properties": {
          "identifier": {
            "type": "string",
            "default": "",
            "description": "User ID",
            "example": "user-1",
            "minLength": 1
          },
          "firstName": {
            "type": "string",
            "default": "",
            "description": "First name",
            "example": "Jane",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "default": "",
            "description": "Last name",
            "example": "Doe",
            "minLength": 1
          },
          "username": {
            "type": "string",
            "default": "",
            "description": "Unique user email",
            "example": "jane@doe.com",
            "minLength": 1
          },
          "profilePicture": {
            "$ref": "#/components/schemas/SimpleMultimedia",
            "default": "",
            "description": "Profile picture url that originates from a federated authentication system"
          },
          "profilePictureUrl": {
            "type": "string",
            "default": "",
            "description": "A fully qualified URL based on the Cloudinary identifier",
            "example": "https://res.cloudinary.com/traveliko/image/upload/c_scale,h_512,q_auto:best,w_512/k8nvegwqn0ih3xqioykn.jpg"
          }
        },
        "required": [
          "firstName",
          "identifier",
          "lastName",
          "username"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "confirmPassword",
          "currentPassword",
          "password"
        ]
      },
      "BooleanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": false,
            "description": "Whether call to endpoint was successful or not."
          },
          "message": {
            "type": "string",
            "default": "",
            "description": "A message indicating more textual information. Mostly used to convey an error message."
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2ClientCredentials": {
        "type": "oauth2",
        "description": "## Retrieve access token\nMake a POST (`Content-Type: application/x-www-form-urlencoded`) request to the Token URL below. Include one POST key/value entry: `grant_type=client_credentials` and include your clientID / secretKey credentials in a Basic Auth header. E.g. `Authorization: Basic base64_encode($clientId + ':' + $secretKey)`.\n## Add Bearer access token to all API requests\nOnce you have the access token, you can pass that along on all API requests in the authentication header: `'Authorization: Bearer $accessToken`",
        "name": "Client Credentials",
        "flows": {
          "clientCredentials": {
            "authorizationUrl": "https://iam.wink.travel/oauth2/authorize",
            "tokenUrl": "https://iam.wink.travel/oauth2/token",
            "refreshUrl": "https://iam.wink.travel/oauth2/refresh",
            "scopes": {
              "account.read": "View your account settings.",
              "account.write": "Create and update your account settings.",
              "account.remove": "Delete your account settings."
            }
          }
        }
      }
    }
